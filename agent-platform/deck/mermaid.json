{
  "theme": "base",
  "fontFamily": "Noto Sans CJK KR, sans-serif",
  "themeVariables": {
    "fontFamily": "Noto Sans CJK KR, sans-serif",
    "fontSize": "19px",
    "primaryColor": "#EEF0FE",
    "primaryTextColor": "#1E1B4B",
    "primaryBorderColor": "#A5A0E5",
    "lineColor": "#6F69B8",
    "secondaryColor": "#F4F3FE",
    "tertiaryColor": "#FAFAFE",
    "actorBkg": "#EEF0FE",
    "actorTextColor": "#1E1B4B",
    "actorLineColor": "#A5A0E5",
    "signalColor": "#3B3670",
    "signalTextColor": "#1E1B4B",
    "noteBkgColor": "#F5F0DC",
    "noteTextColor": "#1E1B4B",
    "clusterBkg": "#FAFAFE",
    "clusterBorder": "#C7C2F5"
  },
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 40,
    "rankSpacing": 45,
    "padding": 12
  },
  "sequence": {
    "actorFontSize": 19,
    "noteFontSize": 16,
    "messageFontSize": 18,
    "width": 175
  },
  "gantt": {
    "fontSize": 15,
    "barHeight": 18,
    "sectionFontSize": 16
  }
}
