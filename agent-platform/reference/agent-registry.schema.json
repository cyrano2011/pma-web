{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itgrims.co.kr/schemas/agent-registry/v1",
  "title": "업무 에이전트 등록부",
  "description": "모든 에이전트 레포 루트에 agent.yaml 로 존재해야 한다. CI 가 이 스키마로 검증하고, 위험 등급을 자동 판정한다. 선언과 실제 코드가 불일치하면 배포가 차단된다.",
  "type": "object",
  "required": [
    "id", "name", "purpose", "owner", "backup_owner",
    "lane", "data_classes", "input_sources", "models", "tools", "review_due"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent-[a-z0-9-]{3,40}$",
      "description": "Keycloak client id 와 동일해야 한다"
    },
    "name": { "type": "string", "maxLength": 60 },
    "purpose": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "이 에이전트가 무슨 업무를 대신하는가. 한 문단."
    },
    "owner": {
      "type": "string",
      "format": "email",
      "description": "업무 담당 부서의 사람. IT 담당자를 적으면 안 된다."
    },
    "backup_owner": { "type": "string", "format": "email" },
    "department": { "type": "string" },

    "lane": {
      "enum": ["L0", "L1", "L2"],
      "description": "L0 실험 / L1 부서 / L2 운영"
    },

    "data_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["synthetic", "public", "internal", "pii", "sensitive"]
      },
      "description": "synthetic=합성, pii=고객 개인정보, sensitive=주민번호·결제정보 등"
    },

    "input_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "trusted_internal",
          "employee_prompt",
          "customer_message",
          "email",
          "web_content",
          "uploaded_file",
          "third_party_api"
        ]
      },
      "description": "customer_message / email / web_content / uploaded_file / third_party_api 는 신뢰할 수 없는 입력(untrusted)으로 간주한다"
    },

    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "AI 게이트웨이에 등록된 model_name 만 허용"
    },

    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "mcp_server"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "mcp_server": {
            "type": "string",
            "description": "내부 MCP 레지스트리에 등재된 서버 id"
          },
          "kind": {
            "enum": ["read", "write", "external_send"],
            "description": "read=조회, write=사내 상태 변경, external_send=사외 발신(메일·SMS·외부 API)"
          },
          "scope": { "type": "string", "description": "Keycloak scope" },
          "rate_limit_per_hour": { "type": "integer", "minimum": 1 }
        }
      }
    },

    "human_in_loop": {
      "type": "boolean",
      "default": false,
      "description": "write / external_send 실행 전 사람 승인 필요 여부"
    },

    "users": {
      "type": "object",
      "properties": {
        "scope": { "enum": ["self", "department", "company", "external"] },
        "estimated_count": { "type": "integer" }
      }
    },

    "ai_disclosure": {
      "type": "boolean",
      "default": true,
      "description": "AI 생성물 고지 문구 삽입 여부. 대외 노출 에이전트는 true 강제 (AI 기본법 투명성 의무)"
    },

    "high_impact_use_case": {
      "type": "boolean",
      "default": false,
      "description": "채용·인사평가·신용평가·안전 관련 여부. true 면 법무 승인 필수"
    },

    "monthly_budget_usd": { "type": "number", "minimum": 0 },

    "review_due": {
      "type": "string",
      "format": "date",
      "description": "이 날짜가 지나면 자동 비활성화된다. 최대 1년."
    }
  },

  "allOf": [
    {
      "if": { "properties": { "lane": { "const": "L0" } }, "required": ["lane"] },
      "then": {
        "properties": {
          "data_classes": {
            "items": { "enum": ["synthetic", "public"] },
            "description": "L0 에는 실데이터를 넣을 수 없다"
          },
          "tools": {
            "items": { "properties": { "kind": { "const": "read" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tools": {
            "contains": { "properties": { "kind": { "enum": ["write", "external_send"] } } }
          }
        }
      },
      "then": {
        "properties": { "lane": { "const": "L2" } },
        "required": ["human_in_loop", "monthly_budget_usd"],
        "description": "쓰기/외부발신 도구를 가지면 L2 심사 대상이다"
      }
    }
  ],

  "$comment": "── 치명 조합 자동 판정 (CI 에서 별도 검사) ──\n다음 3가지를 동시에 만족하면 배포를 차단하고 재설계를 요구한다:\n  (1) data_classes 에 pii 또는 sensitive 포함\n  (2) input_sources 에 신뢰불가 입력(customer_message/email/web_content/uploaded_file/third_party_api) 포함\n  (3) tools 에 kind=external_send 또는 kind=write 포함\n이 조합은 프롬프트 인젝션으로 데이터 유출이 성립하는 구조다.\n해제 조건: 셋 중 하나 제거, 또는 human_in_loop=true 로 사람 승인 삽입."
}
