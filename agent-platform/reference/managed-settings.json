{
  "forceLoginOrgUUID": "<조직 UUID — 개인 계정 로그인 차단>",
  "apiKeyHelper": "/opt/itgrims/bin/gateway-key.sh",

  "availableModels": [
    "claude-opus-5",
    "claude-sonnet-5",
    "claude-haiku-4-5-20251001"
  ],

  "env": {
    "ANTHROPIC_BASE_URL": "https://ai-gw.internal.itgrims.co.kr/anthropic",
    "DISABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.internal.itgrims.co.kr"
  },

  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allowManagedPermissionRulesOnly": true,
    "deny": [
      "Read(//home/*/.ssh/**)",
      "Read(//home/*/.aws/**)",
      "Read(//home/*/.kube/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*credential*)",
      "Read(//**/*secret*)",
      "Edit(//etc/**)",
      "Edit(//home/*/.claude/**)",
      "Edit(//**/.git/hooks/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(aws s3 sync:*)",
      "Bash(docker run --privileged:*)",
      "Bash(sudo:*)",
      "Bash(npm publish:*)",
      "Bash(pip install --index-url:*)"
    ],
    "allow": [
      "Bash(git:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(pytest:*)",
      "Bash(uv:*)"
    ]
  },

  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    "itgrims-mcp-gateway"
  ],
  "allowManagedHooksOnly": true,

  "sandbox": {
    "network": {
      "allowManagedDomainsOnly": true,
      "strictAllowlist": true,
      "allowedDomains": [
        "ai-gw.internal.itgrims.co.kr",
        "mcp-gw.internal.itgrims.co.kr",
        "npm-proxy.internal.itgrims.co.kr",
        "pypi-proxy.internal.itgrims.co.kr",
        "github.com",
        "api.github.com",
        "api.anthropic.com",
        "claude.ai",
        "platform.claude.com"
      ]
    },
    "filesystem": {
      "allowManagedReadPathsOnly": false,
      "denyRead": [
        "//home/*/.ssh",
        "//home/*/.aws",
        "//home/*/Downloads",
        "//mnt/share"
      ]
    }
  }
}
